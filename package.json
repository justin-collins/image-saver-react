{
	"name": "image-saver-react",
	"version": "0.0.1",
	"description": "An app for saving images locally",
	"main": "dist/main.js",
	"private": true,
	"scripts": {
		"dev": "vite",
		"test": "jest",
		"eslint": "eslint",
		"start": "vite",
		"postinstall": "electron-builder install-app-deps",
		"build": "tsc && vite build && electron-builder",
		"build:mac": "npm run build -- --mac",
		"build:linux": "npm run build -- --linux",
		"build:windows": "npm run build -- --windows",
		"rebuild": "electron-rebuild -f -w better-sqlite3-multiple-ciphers"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/justin-collins/image-saver-react.git"
	},
	"keywords": [],
	"author": "Justin Collins <justin@*******.com>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/justin-collins/image-saver-react/issues"
	},
	"homepage": "https://github.com/justin-collins/image-saver-react#readme",
	"build": {
		"productName": "ImageSaver",
		"appId": "com.justincollins|electron.justincollins",
		"directories": {
			"buildResources": "resources"
		},
		"win": {
			"target": [
				"nsis",
				"msi"
			]
		},
		"linux": {
			"target": [
				"deb",
				"snap",
				"AppImage"
			]
		}
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/jest": "^30.0.0",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.2.1",
		"electron": "^45.2.3",
		"electron-builder": "^26.18.0",
		"eslint": "^9.39.5",
		"eslint-plugin-jest": "^29.17.0",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.14.0",
		"identity-obj-proxy": "^3.0.0",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"prettier": "^3.9.10",
		"ts-jest": "^29.4.15",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6",
		"vite-plugin-electron": "^0.29.1"
	},
	"dependencies": {
		"@mantine/core": "^9.7.5",
		"@mantine/hooks": "^9.7.5",
		"@mantine/notifications": "^9.7.5",
		"@tabler/icons-react": "^3.50.0",
		"better-sqlite3-multiple-ciphers": "^13.0.4-beta.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.1"
	}
}
